[Desktop Entry]
Type=Service
MimeType=all/allfiles;inode/directory;
Actions=ShareViaAirDrop;
X-KDE-Priority=TopLevel

[Desktop Action ShareViaAirDrop]
Name=Share via AirDrop…
Name[ko]=AirDrop으로 공유…
Name[ja]=AirDropで共有…
Icon=preferences-system-network-share
Exec=/usr/bin/goldengate-airdrop --send %F
