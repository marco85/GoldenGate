[Desktop Entry]
Name=Find My
Comment=Apple Find My for GoldenGate OS
Exec=/bin/sh -c 'google-chrome-stable --app="https://www.icloud.com/find/" || chromium --app="https://www.icloud.com/find/" || xdg-open "https://www.icloud.com/find/"'
Icon=mark-location
Terminal=false
Type=Application
Categories=Network;Utility;
StartupWMClass=crx_https_www.icloud.com_find_
