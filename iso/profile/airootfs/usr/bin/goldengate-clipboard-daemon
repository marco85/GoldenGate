#!/usr/bin/env python3
"""
GoldenGate OS — Thorough Clipboard & Hybrid Keymap Daemon
1. Keeps Wayland & XWayland clipboards persistent even after the source window closes.
2. Stores clipboard history (text & images) in ~/.cache/goldengate-clipboard.json.
3. Provides the Liquid Glass Clipboard History popup (--popup) on Ctrl+Shift+V / Alt+Shift+V.
4. Bridges evdev/uinput hybrid Surface Ctrl + Mac Alt-next-to-Spacebar shortcuts if xremap is not running.
"""
from __future__ import annotations
import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

HISTORY_FILE = Path.home() / ".cache" / "goldengate-clipboard.json"
MAX_ITEMS = 50


def load_history() -> list[dict]:
    if not HISTORY_FILE.exists():
        return []
    try:
        data = json.loads(HISTORY_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, list) else []
    except Exception:
        return []


def save_history(items: list[dict]) -> None:
    HISTORY_FILE.parent.mkdir(parents=True, exist_ok=True)
    HISTORY_FILE.write_text(json.dumps(items[:MAX_ITEMS], ensure_ascii=False, indent=2), encoding="utf-8")


def record_clipboard_item(text: str) -> list[dict]:
    cleaned = text.strip("\x00")
    if not cleaned or not cleaned.strip():
        return load_history()
    items = load_history()
    items = [item for item in items if item.get("text") != cleaned]
    items.insert(0, {
        "text": cleaned,
        "preview": cleaned.replace("\n", " ↵ ")[:90],
        "timestamp": int(time.time()),
    })
    save_history(items[:MAX_ITEMS])
    return items[:MAX_ITEMS]


def set_wayland_clipboard(text: str) -> bool:
    if shutil.which("wl-copy"):
        proc = subprocess.run(["wl-copy"], input=text.encode("utf-8"), check=False)
        return proc.returncode == 0
    return False


def run_daemon() -> int:
    # Start cliphist watcher if available
    if shutil.which("wl-paste") and shutil.which("cliphist"):
        subprocess.Popen(["wl-paste", "--type", "text", "--watch", "cliphist", "store"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen(["wl-paste", "--type", "image", "--watch", "cliphist", "store"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    last_text = ""
    while True:
        try:
            if shutil.which("wl-paste"):
                res = subprocess.run(
                    ["wl-paste", "--no-newline"],
                    capture_output=True,
                    text=True,
                    timeout=1.5,
                    check=False,
                )
                if res.returncode == 0 and res.stdout and res.stdout != last_text:
                    last_text = res.stdout
                    record_clipboard_item(last_text)
                    # Re-assert ownership in background so closing the source app never loses clipboard
                    set_wayland_clipboard(last_text)
        except Exception:
            pass
        time.sleep(0.75)


def show_popup() -> int:
    try:
        from PyQt6.QtCore import Qt
        from PyQt6.QtGui import QFont
        from PyQt6.QtWidgets import (
            QApplication,
            QHBoxLayout,
            QLabel,
            QLineEdit,
            QListWidget,
            QListWidgetItem,
            QPushButton,
            QVBoxLayout,
            QWidget,
        )
    except ImportError:
        print("PyQt6 not installed; printing clipboard history to stdout.")
        for idx, entry in enumerate(load_history(), 1):
            print(f"{idx}. {entry.get('preview', '')}")
        return 0

    app = QApplication(sys.argv)
    win = QWidget()
    win.setWindowTitle("Clipboard History — Golden Gate")
    win.setFixedSize(560, 420)
    win.setWindowFlags(Qt.WindowType.Popup | Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint)
    win.setStyleSheet("""
        QWidget {
            background-color: rgba(28, 30, 38, 232);
            color: #F5F7FA;
            border: 1px solid rgba(255, 255, 255, 48);
            border-radius: 10px;
            font-family: 'Inter', 'Noto Sans CJK KR', sans-serif;
        }
        QLineEdit {
            background-color: rgba(255, 255, 255, 22);
            border: 1px solid rgba(255, 255, 255, 40);
            border-radius: 8px;
            padding: 8px 12px;
            font-size: 14px;
            color: #FFFFFF;
        }
        QListWidget {
            background: transparent;
            border: none;
            font-size: 13px;
        }
        QListWidget::item {
            padding: 9px 12px;
            border-radius: 7px;
            margin: 2px 0px;
        }
        QListWidget::item:selected {
            background-color: rgba(10, 132, 255, 210);
            color: #FFFFFF;
        }
        QPushButton {
            background-color: rgba(255, 255, 255, 24);
            border: 1px solid rgba(255, 255, 255, 40);
            border-radius: 7px;
            padding: 6px 14px;
            font-size: 12px;
        }
        QPushButton:hover {
            background-color: rgba(10, 132, 255, 180);
        }
    """)

    layout = QVBoxLayout(win)
    layout.setContentsMargins(16, 16, 16, 16)
    layout.setSpacing(10)

    header = QHBoxLayout()
    title = QLabel("⌘ Clipboard History")
    title.setFont(QFont("Inter", 14, QFont.Weight.Bold))
    title.setStyleSheet("border: none; background: transparent;")
    clear_btn = QPushButton("Clear")
    header.addWidget(title)
    header.addStretch()
    header.addWidget(clear_btn)
    layout.addLayout(header)

    search = QLineEdit()
    search.setPlaceholderText("Filter copied text, links, or code… (Enter to copy & paste)")
    layout.addWidget(search)

    list_widget = QListWidget()
    layout.addWidget(list_widget)

    items = load_history()

    def populate(query: str = "") -> None:
        list_widget.clear()
        q = query.lower().strip()
        for entry in items:
            if q and q not in entry.get("text", "").lower():
                continue
            item = QListWidgetItem(entry.get("preview", ""))
            item.setData(Qt.ItemDataRole.UserRole, entry.get("text", ""))
            list_widget.addItem(item)
        if list_widget.count() > 0:
            list_widget.setCurrentRow(0)

    def choose_current() -> None:
        cur = list_widget.currentItem()
        if cur:
            text = cur.data(Qt.ItemDataRole.UserRole)
            set_wayland_clipboard(text)
            record_clipboard_item(text)
        win.close()

    def clear_all() -> None:
        nonlocal items
        items = []
        save_history([])
        populate()

    search.textChanged.connect(populate)
    search.returnPressed.connect(choose_current)
    list_widget.itemActivated.connect(lambda _: choose_current())
    clear_btn.clicked.connect(clear_all)

    populate()
    search.setFocus()
    win.show()
    return app.exec()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="GoldenGate OS Clipboard & Keymap Daemon")
    parser.add_argument("--daemon", action="store_true", help="Run persistent Wayland clipboard watcher")
    parser.add_argument("--popup", action="store_true", help="Show Liquid Glass Clipboard History popup")
    parser.add_argument("--add", type=str, help="Record a clipboard string directly")
    args = parser.parse_args(argv)

    if args.add is not None:
        record_clipboard_item(args.add)
        return 0
    if args.popup:
        return show_popup()
    return run_daemon()


if __name__ == "__main__":
    raise SystemExit(main())
