#!/usr/bin/env python3
"""
GoldenGate OS — Surface Laptop 5 IR Camera ("Face ID") Detection & Enrollment
Detects the Surface Laptop 5 USB UVC IR camera (045e:0965 / /dev/v4l/by-id/*IR* / /dev/video2),
configures linux-enable-ir-emitter and /etc/howdy/config.ini, and enrolls a Face ID model.
"""
from __future__ import annotations
import argparse
import glob
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


def detect_ir_camera(sysfs_root: str = "/sys/class/video4linux", by_id_dir: str = "/dev/v4l/by-id") -> dict:
    """Finds the Surface Laptop 5 IR V4L2 device node."""
    # 1. Check /dev/v4l/by-id for IR camera symlink
    by_id_path = Path(by_id_dir)
    if by_id_path.is_dir():
        for entry in sorted(by_id_path.iterdir()):
            if "ir" in entry.name.lower() and "index0" in entry.name.lower():
                resolved = str(entry.resolve())
                return {"device": resolved, "name": entry.name, "source": "v4l-by-id"}

    # 2. Check /sys/class/video4linux/video*/name
    sys_path = Path(sysfs_root)
    if sys_path.is_dir():
        for vdir in sorted(sys_path.glob("video*")):
            name_file = vdir / "name"
            if name_file.is_file():
                dev_name = name_file.read_text(encoding="utf-8", errors="ignore").strip()
                if "ir" in dev_name.lower() or "0965" in dev_name.lower():
                    return {
                        "device": f"/dev/{vdir.name}",
                        "name": dev_name,
                        "source": "sysfs",
                    }

    # 3. Default Surface Laptop 5 IR node fallback (/dev/video2)
    return {
        "device": "/dev/video2",
        "name": "Microsoft Surface IR Camera Front (Default)",
        "source": "fallback",
    }


def render_howdy_config(device_path: str) -> str:
    return f"""# Auto-generated by GoldenGate OS Face ID Setup (Surface Laptop 5)
[core]
detection_notice = false
timeout_notice = false
no_confirmation = true
suppress_unknown = true
abort_if_ssh = true
abort_if_lid_closed = true
disabled = false
use_cnn = false
workaround = off

[video]
certainty = 3.5
timeout = 2
device_path = {device_path}
warn_no_device = false
max_height = 320
frame_width = -1
frame_height = -1
dark_threshold = 60
recording_plugin = opencv
device_format = v4l2
force_mjpeg = false
exposure = -1

[snapshots]
save_failed = false
save_successful = false
"""


def configure_system_faceid(device_path: str, config_target: Path = Path("/etc/howdy/config.ini")) -> dict:
    config_target.parent.mkdir(parents=True, exist_ok=True)
    config_target.write_text(render_howdy_config(device_path), encoding="utf-8")

    emitter_ok = False
    if shutil.which("linux-enable-ir-emitter"):
        res = subprocess.run(
            ["linux-enable-ir-emitter", "configure", "-d", device_path],
            check=False,
        )
        subprocess.run(["systemctl", "enable", "--now", "linux-enable-ir-emitter.service"], check=False)
        emitter_ok = res.returncode == 0

    return {
        "device_path": device_path,
        "howdy_config": str(config_target),
        "emitter_configured": emitter_ok,
    }


def enroll_user_face(user: str | None = None, label: str = "GoldenGate-FaceID") -> bool:
    if not shutil.which("howdy"):
        return False
    cmd = ["howdy"]
    if user:
        cmd.extend(["-U", user])
    cmd.extend(["add", "-y", label])
    res = subprocess.run(cmd, check=False)
    return res.returncode == 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="GoldenGate OS Face ID (IR Camera) Setup")
    parser.add_argument("--detect", action="store_true", help="Detect IR camera and print JSON")
    parser.add_argument("--configure", action="store_true", help="Write /etc/howdy/config.ini and configure IR emitter")
    parser.add_argument("--enroll", action="store_true", help="Enroll current user's face model")
    parser.add_argument("--user", type=str, help="Username for enrollment")
    parser.add_argument("--config-path", type=str, default="/etc/howdy/config.ini", help="Target howdy config path")
    args = parser.parse_args(argv)

    detected = detect_ir_camera()
    if args.detect and not args.configure and not args.enroll:
        print(json.dumps(detected, indent=2))
        return 0

    result = {"detected": detected}
    if args.configure:
        result["configured"] = configure_system_faceid(detected["device"], Path(args.config_path))
    if args.enroll:
        result["enrolled"] = enroll_user_face(args.user)

    print(json.dumps(result, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
