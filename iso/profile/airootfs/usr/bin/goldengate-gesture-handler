#!/usr/bin/env python3
"""
GoldenGate OS — Multi-Touch Trackpad & PixelSense Touchscreen Gesture Handler
Maps 3-finger and 4-finger gestures to macOS 27 Golden Gate actions:
  - mission-control (3/4-finger swipe up)     -> KWin Overview (Mission Control + Spaces)
  - app-expose      (3/4-finger swipe down)   -> KWin Expose (Current Application Windows)
  - space-left      (3/4-finger swipe right)  -> Switch One Desktop to the Left
  - space-right     (3/4-finger swipe left)   -> Switch One Desktop to the Right
  - launchpad       (4-finger pinch in)       -> Toggle Launchpad Application Dashboard
  - show-desktop    (4-finger spread out)     -> KWin Show Desktop
  - notifications   (2-finger right edge)     -> Toggle Notification Center
  - pull-refresh    (swipe down in browser)   -> Refresh active page
"""
from __future__ import annotations
import argparse
import json
import shutil
import subprocess
import sys

GESTURE_SHORTCUTS = {
    "mission-control": ("kwin", "Overview"),
    "app-expose": ("kwin", "Expose"),
    "space-left": ("kwin", "Switch One Desktop to the Left"),
    "space-right": ("kwin", "Switch One Desktop to the Right"),
    "show-desktop": ("kwin", "ShowDesktop"),
    "launchpad": ("plasmashell", "activate application launcher"),
    "notifications": ("plasmashell", "show-on-screen-indicator"),
}


def trigger_gesture(gesture: str, dry_run: bool = False) -> dict:
    if gesture not in GESTURE_SHORTCUTS and gesture != "pull-refresh":
        raise ValueError(f"Unknown gesture: {gesture}")

    if gesture == "pull-refresh":
        payload = {"gesture": gesture, "component": "browser", "action": "reload"}
        if not dry_run and shutil.which("ydotool"):
            # Send Ctrl+R (keycodes 29 + 19) to refresh active window
            subprocess.run(["ydotool", "key", "29:1", "19:1", "19:0", "29:0"], check=False)
        return payload

    component, shortcut = GESTURE_SHORTCUTS[gesture]
    payload = {"gesture": gesture, "component": component, "shortcut": shortcut}
    if not dry_run and shutil.which("qdbus6"):
        subprocess.run(
            [
                "qdbus6",
                "org.kde.kglobalaccel",
                f"/component/{component}",
                "org.kde.kglobalaccel.Component.invokeShortcut",
                shortcut,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    return payload


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="GoldenGate OS Multi-Touch Gesture Handler")
    parser.add_argument(
        "gesture",
        choices=list(GESTURE_SHORTCUTS.keys()) + ["pull-refresh"],
        help="Gesture action to trigger",
    )
    parser.add_argument("--dry-run", action="store_true", help="Output JSON action without invoking D-Bus")
    args = parser.parse_args(argv)

    result = trigger_gesture(args.gesture, dry_run=args.dry_run)
    if args.dry_run:
        print(json.dumps(result))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
