#!/usr/bin/env python3
"""
GoldenGate OS — Trackpad Natural Scrolling & Scroll Dampening Configurator
Scans connected touchpad devices on Surface Laptop 5 and any hardware,
writes device-specific sections into ~/.config/kcminputrc, and applies
natural scrolling, 0.35 scroll dampening, and tap-to-click live via KWin Wayland D-Bus.
"""
from __future__ import annotations
import configparser
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

KCMINPUTRC = Path.home() / ".config" / "kcminputrc"


def parse_input_devices() -> list[dict]:
    devices = []
    proc_devices = Path("/proc/bus/input/devices")
    if not proc_devices.exists():
        return devices

    current: dict = {}
    for line in proc_devices.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line:
            if current and current.get("is_touchpad"):
                devices.append(current)
            current = {}
            continue

        if line.startswith("I:"):
            # Vendor=045e Product=096f
            v_match = re.search(r"Vendor=([0-9a-fA-F]+)", line)
            p_match = re.search(r"Product=([0-9a-fA-F]+)", line)
            if v_match:
                current["vendor"] = str(int(v_match.group(1), 16))
            if p_match:
                current["product"] = str(int(p_match.group(1), 16))
        elif line.startswith("N: Name="):
            name = line.split("Name=", 1)[-1].strip('"')
            current["name"] = name
            if any(k in name.lower() for k in ("touchpad", "trackpad", "surface", "clickpad", "glidepoint")):
                current["is_touchpad"] = True
        elif line.startswith("H: Handlers=") and "mouse" in line and "touchpad" in current.get("name", "").lower():
            current["is_touchpad"] = True

    if current and current.get("is_touchpad"):
        devices.append(current)
    return devices


def apply_kcminputrc(devices: list[dict]) -> None:
    KCMINPUTRC.parent.mkdir(parents=True, exist_ok=True)
    config = configparser.ConfigParser(interpolation=None)
    if KCMINPUTRC.exists():
        config.read(str(KCMINPUTRC), encoding="utf-8")

    # Global fallback sections
    for sec in ("Touchpad", "Libinput][Touchpad", "Mouse"):
        if not config.has_section(sec):
            config.add_section(sec)
        config.set(sec, "NaturalScroll", "true")
        config.set(sec, "XLbInptNaturalScroll", "true")
        config.set(sec, "ScrollFactor", "0.35")
        config.set(sec, "TapToClick", "true")

    # Device-specific sections
    for d in devices:
        vendor = d.get("vendor", "1118")
        product = d.get("product", "0")
        name = d.get("name", "Touchpad")
        sec_name = f"Libinput][{vendor}][{product}][{name}"
        if not config.has_section(sec_name):
            config.add_section(sec_name)
        config.set(sec_name, "NaturalScroll", "true")
        config.set(sec_name, "ScrollFactor", "0.35")
        config.set(sec_name, "TapToClick", "true")
        config.set(sec_name, "DisableWhileTyping", "true")

    with KCMINPUTRC.open("w", encoding="utf-8") as f:
        config.write(f)


def apply_kwin_dbus() -> None:
    if not shutil.which("qdbus6"):
        return
    try:
        res = subprocess.run(
            ["qdbus6", "org.kde.KWin", "/org/kde/KWin/InputDevice"],
            capture_output=True,
            text=True,
            timeout=3,
            check=False,
        )
        for dev_path in res.stdout.splitlines():
            dev_path = dev_path.strip()
            if not dev_path or not dev_path.startswith("/org/kde/KWin/InputDevice/"):
                continue

            # Check if this input device is a touchpad
            chk = subprocess.run(
                ["qdbus6", "org.kde.KWin", dev_path, "org.kde.KWin.InputDevice.touchpad"],
                capture_output=True,
                text=True,
                timeout=2,
                check=False,
            )
            is_tp = chk.stdout.strip().lower() == "true"
            if is_tp:
                subprocess.run([
                    "qdbus6", "org.kde.KWin", dev_path,
                    "org.freedesktop.DBus.Properties.Set",
                    "org.kde.KWin.InputDevice", "naturalScroll", "true"
                ], timeout=2, check=False)
                subprocess.run([
                    "qdbus6", "org.kde.KWin", dev_path,
                    "org.freedesktop.DBus.Properties.Set",
                    "org.kde.KWin.InputDevice", "scrollFactor", "0.35"
                ], timeout=2, check=False)
                subprocess.run([
                    "qdbus6", "org.kde.KWin", dev_path,
                    "org.freedesktop.DBus.Properties.Set",
                    "org.kde.KWin.InputDevice", "tapToClick", "true"
                ], timeout=2, check=False)
    except Exception:
        pass


def main() -> int:
    devices = parse_input_devices()
    apply_kcminputrc(devices)
    apply_kwin_dbus()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
