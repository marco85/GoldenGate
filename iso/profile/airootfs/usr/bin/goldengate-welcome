#!/usr/bin/env python3
"""
GoldenGate OS — First-Boot macOS 27 Setup Assistant
Pages:
  1. Wi-Fi Connection (with signal strength & lock icons)
  2. Face ID (Surface Laptop 5 IR Camera + Emitter enrollment)
  3. Liquid Glass & Appearance (Live translucency slider, colored sidebars, snap margins)
  4. AirDrop & iPhone Continuity (LocalSend + Zero-App Safari URL + KDE Connect)
  5. AI Workspace & Secure Boot (Antigravity GUI/CLI, Claude, Codex, Secure Boot MOK)
"""
from __future__ import annotations
import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

DONE_MARKER = Path.home() / ".config" / "goldengate" / "welcome-completed"


def scan_wifi_networks() -> list[dict]:
    networks = []
    if not shutil.which("nmcli"):
        return networks
    try:
        res = subprocess.run(
            ["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "dev", "wifi", "list"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        seen = set()
        for line in res.stdout.splitlines():
            parts = line.split(":")
            if len(parts) >= 3:
                ssid = parts[0].strip()
                if not ssid or ssid in seen:
                    continue
                seen.add(ssid)
                sig = int(parts[1]) if parts[1].isdigit() else 0
                sec = bool(parts[2].strip() and parts[2].strip() != "--")
                networks.append({"ssid": ssid, "signal": sig, "secured": sec})
    except Exception:
        pass
    return sorted(networks, key=lambda x: x["signal"], reverse=True)


def get_setup_steps_summary() -> list[dict]:
    return [
        {"id": "wifi", "title": "Connect to Wi-Fi", "description": "Select your wireless network to get online."},
        {
            "id": "faceid",
            "title": "Set Up Face ID (IR Camera)",
            "description": "Use your Surface Laptop 5 infrared camera to unlock your Mac, sudo, and prompts.",
        },
        {
            "id": "liquid-glass",
            "title": "Liquid Glass & Appearance",
            "description": "Tune your macOS 27 Golden Gate Liquid Glass translucency slider and colored sidebars.",
        },
        {
            "id": "airdrop",
            "title": "AirDrop & iPhone Continuity",
            "description": "Pair your iPhone via LocalSend, Zero-App Safari AirDrop, and KDE Connect.",
        },
        {
            "id": "apps",
            "title": "Antigravity, Claude & Codex",
            "description": "Sign in to Antigravity v2.24.0, Claude, and Codex, or enroll Secure Boot.",
        },
    ]


def run_gui() -> int:
    try:
        from PyQt6.QtCore import Qt
        from PyQt6.QtGui import QColor, QFont, QPalette
        from PyQt6.QtWidgets import (
            QApplication,
            QHBoxLayout,
            QLabel,
            QLineEdit,
            QListWidget,
            QPushButton,
            QSlider,
            QStackedWidget,
            QVBoxLayout,
            QWidget,
        )
    except ImportError:
        print(json.dumps({"steps": get_setup_steps_summary()}, indent=2))
        return 0

    app = QApplication(sys.argv)
    app.setStyle("Fusion")

    # Force system dark palette so child widgets and window frame never flash white
    palette = QPalette()
    palette.setColor(QPalette.ColorRole.Window, QColor(24, 26, 36))
    palette.setColor(QPalette.ColorRole.WindowText, QColor(244, 246, 250))
    palette.setColor(QPalette.ColorRole.Base, QColor(18, 20, 28))
    palette.setColor(QPalette.ColorRole.AlternateBase, QColor(24, 26, 36))
    palette.setColor(QPalette.ColorRole.ToolTipBase, QColor(20, 22, 30))
    palette.setColor(QPalette.ColorRole.ToolTipText, QColor(244, 246, 250))
    palette.setColor(QPalette.ColorRole.Text, QColor(244, 246, 250))
    palette.setColor(QPalette.ColorRole.Button, QColor(36, 38, 52))
    palette.setColor(QPalette.ColorRole.ButtonText, QColor(244, 246, 250))
    palette.setColor(QPalette.ColorRole.Highlight, QColor(10, 132, 255))
    palette.setColor(QPalette.ColorRole.HighlightedText, QColor(255, 255, 255))
    app.setPalette(palette)

    win = QWidget()
    win.setObjectName("setupWindow")
    win.setAttribute(Qt.WidgetAttribute.WA_StyledBackground, True)
    win.setWindowTitle("Welcome to GoldenGate OS — Setup Assistant")
    win.setFixedSize(680, 460)
    win.setStyleSheet("""
        #setupWindow, QWidget {
            background-color: #181A24;
            color: #F4F6FA;
            font-family: 'Inter', 'Noto Sans CJK KR', sans-serif;
        }
        QStackedWidget, QWidget#page {
            background-color: transparent;
        }
        QPushButton {
            background-color: #0A84FF;
            color: #FFFFFF;
            border-radius: 8px;
            padding: 8px 18px;
            font-weight: 600;
            border: none;
        }
        QPushButton:hover {
            background-color: #0071E3;
        }
        QPushButton#secondary {
            background-color: rgba(255, 255, 255, 24);
            border: 1px solid rgba(255, 255, 255, 45);
            color: #F4F6FA;
        }
        QPushButton#secondary:disabled {
            background-color: rgba(255, 255, 255, 10);
            border: 1px solid rgba(255, 255, 255, 20);
            color: rgba(244, 246, 250, 70);
        }
        QLineEdit, QListWidget {
            background-color: rgba(255, 255, 255, 18);
            border: 1px solid rgba(255, 255, 255, 36);
            border-radius: 8px;
            padding: 6px 10px;
            color: #FFFFFF;
        }
    """)

    root = QVBoxLayout(win)
    root.setContentsMargins(26, 22, 26, 22)
    root.setSpacing(14)

    stack = QStackedWidget()
    root.addWidget(stack, stretch=1)

    # Page 1: Wi-Fi
    p_wifi = QWidget()
    l_wifi = QVBoxLayout(p_wifi)
    t1 = QLabel("📶 Connect to Your Wi-Fi Network")
    t1.setFont(QFont("Inter", 16, QFont.Weight.Bold))
    l_wifi.addWidget(t1)
    wifi_list = QListWidget()
    for net in scan_wifi_networks():
        lock = "🔒" if net["secured"] else "🔓"
        wifi_list.addItem(f"{lock}  {net['ssid']}   ({net['signal']}%)")
    l_wifi.addWidget(wifi_list)
    wifi_pass = QLineEdit()
    wifi_pass.setEchoMode(QLineEdit.EchoMode.Password)
    wifi_pass.setPlaceholderText("Enter Wi-Fi password and press Enter…")
    l_wifi.addWidget(wifi_pass)

    def connect_selected_wifi() -> None:
        item = wifi_list.currentItem()
        if item and shutil.which("nmcli"):
            raw = item.text().split("  ", 1)[-1].rsplit("   (", 1)[0].strip()
            subprocess.Popen(["nmcli", "dev", "wifi", "connect", raw, "password", wifi_pass.text()])

    wifi_pass.returnPressed.connect(connect_selected_wifi)
    stack.addWidget(p_wifi)

    # Page 2: Face ID
    p_face = QWidget()
    l_face = QVBoxLayout(p_face)
    t2 = QLabel("🔒 Set Up Face ID (Surface Laptop 5 IR Camera)")
    t2.setFont(QFont("Inter", 16, QFont.Weight.Bold))
    l_face.addWidget(t2)
    face_desc = QLabel(
        "Your Surface Laptop 5 includes an infrared camera next to the front webcam. "
        "Click below to configure the IR emitter and scan your face so you can unlock the Lock Screen, "
        "system prompts, and sudo automatically."
    )
    face_desc.setWordWrap(True)
    l_face.addWidget(face_desc)
    enroll_btn = QPushButton("Scan Your Face Now…")
    enroll_btn.clicked.connect(
        lambda: subprocess.Popen(["pkexec", "/usr/bin/goldengate-faceid-setup", "--configure", "--enroll"])
    )
    l_face.addWidget(enroll_btn, alignment=Qt.AlignmentFlag.AlignLeft)
    l_face.addStretch()
    stack.addWidget(p_face)

    # Page 3: Liquid Glass
    p_glass = QWidget()
    l_glass = QVBoxLayout(p_glass)
    t3 = QLabel("✨ Customize Liquid Glass & Appearance")
    t3.setFont(QFont("Inter", 16, QFont.Weight.Bold))
    l_glass.addWidget(t3)
    glass_lbl = QLabel("Liquid Glass Translucency: 78%")
    l_glass.addWidget(glass_lbl)
    glass_slider = QSlider(Qt.Orientation.Horizontal)
    glass_slider.setRange(0, 100)
    glass_slider.setValue(78)

    def update_glass(val: int) -> None:
        glass_lbl.setText(f"Liquid Glass Translucency: {val}%")
        subprocess.Popen(["/usr/bin/goldengate-liquid-glass", "--set-level", str(val)])

    glass_slider.valueChanged.connect(update_glass)
    l_glass.addWidget(glass_slider)
    l_glass.addStretch()
    stack.addWidget(p_glass)

    # Page 4: AirDrop
    p_airdrop = QWidget()
    l_airdrop = QVBoxLayout(p_airdrop)
    t4 = QLabel("📡 Set Up AirDrop & iPhone Continuity")
    t4.setFont(QFont("Inter", 16, QFont.Weight.Bold))
    l_airdrop.addWidget(t4)
    airdrop_desc = QLabel(
        "AirDrop is active in the background via LocalSend, Zero-App Safari QR Bridge, and KDE Connect.\n"
        "You can right-click any file in Finder and choose 'Share via AirDrop…' or drop files onto the AirDrop icon in the Dock."
    )
    airdrop_desc.setWordWrap(True)
    l_airdrop.addWidget(airdrop_desc)
    open_ad_btn = QPushButton("Open AirDrop Radar & iPhone Pairing…")
    open_ad_btn.clicked.connect(lambda: subprocess.Popen(["/usr/bin/goldengate-airdrop"]))
    l_airdrop.addWidget(open_ad_btn, alignment=Qt.AlignmentFlag.AlignLeft)
    l_airdrop.addStretch()
    stack.addWidget(p_airdrop)

    # Page 5: AI Workspace & Finish
    p_apps = QWidget()
    l_apps = QVBoxLayout(p_apps)
    t5 = QLabel("🚀 Ready to Use — Antigravity, Claude & Codex")
    t5.setFont(QFont("Inter", 16, QFont.Weight.Bold))
    l_apps.addWidget(t5)
    apps_desc = QLabel(
        "• Antigravity App (v2.24.0) & Antigravity CLI (v1.4.0) are installed and pinned to your Dock.\n"
        "• Press Ctrl+Space (or Alt+Space) to switch between English, 한국어, and 日本語.\n"
        "• Both Ctrl and Alt (next to Spacebar) work as ⌘ Command for Copy/Paste across all apps."
    )
    apps_desc.setWordWrap(True)
    l_apps.addWidget(apps_desc)

    btn_row = QHBoxLayout()
    ag_btn = QPushButton("Launch Antigravity")
    ag_btn.clicked.connect(lambda: subprocess.Popen(["/opt/antigravity/antigravity"]))
    btn_row.addWidget(ag_btn)
    claude_btn = QPushButton("Sign In to Claude CLI")
    claude_btn.setObjectName("secondary")
    claude_btn.clicked.connect(lambda: subprocess.Popen(["konsole", "-e", "claude"]))
    btn_row.addWidget(claude_btn)
    l_apps.addLayout(btn_row)
    l_apps.addStretch()
    stack.addWidget(p_apps)

    # Navigation bar
    nav = QHBoxLayout()
    back_btn = QPushButton("Back")
    back_btn.setObjectName("secondary")
    next_btn = QPushButton("Continue")

    def sync_nav() -> None:
        idx = stack.currentIndex()
        back_btn.setEnabled(idx > 0)
        next_btn.setText("Get Started" if idx == stack.count() - 1 else "Continue")

    def on_next() -> None:
        idx = stack.currentIndex()
        if idx < stack.count() - 1:
            stack.setCurrentIndex(idx + 1)
            sync_nav()
        else:
            DONE_MARKER.parent.mkdir(parents=True, exist_ok=True)
            DONE_MARKER.write_text("done\n", encoding="utf-8")
            win.close()

    def on_back() -> None:
        idx = stack.currentIndex()
        if idx > 0:
            stack.setCurrentIndex(idx - 1)
            sync_nav()

    back_btn.clicked.connect(on_back)
    next_btn.clicked.connect(on_next)
    nav.addWidget(back_btn)
    nav.addStretch()
    nav.addWidget(next_btn)
    root.addLayout(nav)

    sync_nav()
    win.show()
    return app.exec()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="GoldenGate OS First-Boot Setup Assistant")
    parser.add_argument("--autostart", action="store_true", help="Exit immediately if already completed")
    parser.add_argument("--steps-json", action="store_true", help="Output setup steps as JSON")
    args = parser.parse_args(argv)

    if args.steps_json:
        print(json.dumps(get_setup_steps_summary(), indent=2))
        return 0
    if args.autostart and DONE_MARKER.exists():
        return 0
    return run_gui()


if __name__ == "__main__":
    raise SystemExit(main())
