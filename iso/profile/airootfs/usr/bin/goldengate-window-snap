#!/usr/bin/env python3
"""
GoldenGate OS — macOS 27 Window Snapping & Tiling Helper
Supports snapping the active window to:
  left, right, top, bottom, top-left, top-right, bottom-left, bottom-right, maximize, center
Honors the user's configured Golden Gate tile margins (8px default) and top Menu Bar / bottom Dock struts.
"""
from __future__ import annotations
import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path

SHORTCUT_MAP = {
    "left": "Window Quick Tile Left",
    "right": "Window Quick Tile Right",
    "top": "Window Quick Tile Top",
    "bottom": "Window Quick Tile Bottom",
    "top-left": "Window Quick Tile Top Left",
    "top-right": "Window Quick Tile Top Right",
    "bottom-left": "Window Quick Tile Bottom Left",
    "bottom-right": "Window Quick Tile Bottom Right",
    "maximize": "Window Maximize",
}


def compute_snap_geometry(
    action: str,
    screen_w: int = 1504,
    screen_h: int = 1002,
    top_bar: int = 28,
    dock_h: int = 64,
    margin: int = 8,
) -> dict[str, int]:
    """Computes pixel-accurate target window geometry on the Surface Laptop 5 (1504x1002 logical @ 1.5x)."""
    usable_x = margin
    usable_y = top_bar + margin
    usable_w = screen_w - (2 * margin)
    usable_h = screen_h - top_bar - dock_h - (2 * margin)
    half_w = (usable_w - margin) // 2
    half_h = (usable_h - margin) // 2

    geometries = {
        "left": {"x": usable_x, "y": usable_y, "w": half_w, "h": usable_h},
        "right": {"x": usable_x + half_w + margin, "y": usable_y, "w": half_w, "h": usable_h},
        "top": {"x": usable_x, "y": usable_y, "w": usable_w, "h": half_h},
        "bottom": {"x": usable_x, "y": usable_y + half_h + margin, "w": usable_w, "h": half_h},
        "top-left": {"x": usable_x, "y": usable_y, "w": half_w, "h": half_h},
        "top-right": {"x": usable_x + half_w + margin, "y": usable_y, "w": half_w, "h": half_h},
        "bottom-left": {"x": usable_x, "y": usable_y + half_h + margin, "w": half_w, "h": half_h},
        "bottom-right": {
            "x": usable_x + half_w + margin,
            "y": usable_y + half_h + margin,
            "w": half_w,
            "h": half_h,
        },
        "maximize": {"x": usable_x, "y": usable_y, "w": usable_w, "h": usable_h},
        "center": {
            "x": usable_x + int(usable_w * 0.12),
            "y": usable_y + int(usable_h * 0.10),
            "w": int(usable_w * 0.76),
            "h": int(usable_h * 0.80),
        },
    }
    return geometries.get(action, geometries["maximize"])


def invoke_kwin_snap(action: str) -> bool:
    shortcut_name = SHORTCUT_MAP.get(action)
    if shortcut_name and shutil.which("qdbus6"):
        res = subprocess.run(
            [
                "qdbus6",
                "org.kde.kglobalaccel",
                "/component/kwin",
                "org.kde.kglobalaccel.Component.invokeShortcut",
                shortcut_name,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return res.returncode == 0
    return False


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="GoldenGate OS Window Snapper")
    parser.add_argument(
        "action",
        choices=list(SHORTCUT_MAP.keys()) + ["center"],
        help="Target window snap zone",
    )
    parser.add_argument("--dry-run", action="store_true", help="Print computed geometry as JSON")
    parser.add_argument("--margin", type=int, default=8, help="Tile margin in px (default 8)")
    args = parser.parse_args(argv)

    geom = compute_snap_geometry(args.action, margin=args.margin)
    if args.dry_run:
        print(json.dumps({"action": args.action, "geometry": geom}))
        return 0

    invoke_kwin_snap(args.action)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
