#!/usr/bin/env python3
"""
GoldenGate OS — macOS 27 "Golden Gate" Liquid Glass Engine & Slider
Controls:
  1. Liquid Glass Translucency & Refraction Slider (0% Opaque Tinted .. 100% Liquid Glass)
  2. Appearance Mode (Dark / Light / Auto)
  3. Golden Gate Uniform Corner Radius (10px default)
  4. Edge-to-Edge Colored Sidebar Icons & Window Snap Tile Margins (8px default)

Writes live configuration to KWin (kwinrc + D-Bus reconfigure), GTK3, GTK4/libadwaita, and Kvantum.
"""
from __future__ import annotations
import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

DEFAULT_STATE = {
    "glass_level": 78,          # 0 (Opaque Tinted) .. 100 (Full Liquid Glass)
    "appearance": "dark",       # "dark" | "light" | "auto"
    "corner_radius": 10,        # macOS 27 Golden Gate dialed-back uniform corner radius
    "colored_sidebars": True,   # macOS 27 Golden Gate colored sidebar icons
    "tile_margins": 8,          # Window snap margin in px (0 for flush, 8 for Golden Gate)
    "menu_clutter_control": True,
}


def get_config_path(root: Path | None = None) -> Path:
    base = root if root else Path.home()
    return base / ".config" / "goldengate" / "liquid-glass.json"


def load_state(root: Path | None = None) -> dict:
    cfg = get_config_path(root)
    state = dict(DEFAULT_STATE)
    if cfg.exists():
        try:
            loaded = json.loads(cfg.read_text(encoding="utf-8"))
            if isinstance(loaded, dict):
                state.update(loaded)
        except Exception:
            pass
    state["glass_level"] = max(0, min(100, int(state.get("glass_level", 78))))
    state["corner_radius"] = max(4, min(18, int(state.get("corner_radius", 10))))
    state["tile_margins"] = max(0, min(20, int(state.get("tile_margins", 8))))
    return state


def save_state(state: dict, root: Path | None = None) -> dict:
    cfg = get_config_path(root)
    cfg.parent.mkdir(parents=True, exist_ok=True)
    cfg.write_text(json.dumps(state, indent=2), encoding="utf-8")
    return state


def compute_glass_metrics(state: dict) -> dict:
    level = state["glass_level"] / 100.0
    is_dark = state.get("appearance", "dark") != "light"
    # At level=1.0 (100% Liquid Glass), window alpha is 0.66; at level=0.0 (Opaque Tinted), alpha is 0.96
    win_alpha = round(0.96 - (0.30 * level), 3)
    sidebar_alpha = round(0.92 - (0.34 * level), 3)
    blur_strength = max(4, int(round(4 + 11 * level)))  # KWin blur strength 4..15
    refraction = round(0.15 + 0.65 * level, 2)
    specular_alpha = round(0.08 + 0.20 * level, 3)
    edge_shadow_alpha = round(0.35 + 0.25 * level, 3)

    if is_dark:
        bg_rgb = "26, 28, 36"
        sidebar_rgb = "20, 22, 30"
        toolbar_rgb = "34, 37, 46"
        fg_hex = "#F4F6FA"
        accent_hex = "#0A84FF"
    else:
        bg_rgb = "246, 248, 252"
        sidebar_rgb = "236, 240, 246"
        toolbar_rgb = "250, 251, 254"
        fg_hex = "#1C1E24"
        accent_hex = "#007AFF"

    return {
        "is_dark": is_dark,
        "win_alpha": win_alpha,
        "sidebar_alpha": sidebar_alpha,
        "blur_strength": blur_strength,
        "refraction": refraction,
        "specular_alpha": specular_alpha,
        "edge_shadow_alpha": edge_shadow_alpha,
        "bg_rgb": bg_rgb,
        "sidebar_rgb": sidebar_rgb,
        "toolbar_rgb": toolbar_rgb,
        "fg_hex": fg_hex,
        "accent_hex": accent_hex,
        "radius": state["corner_radius"],
        "colored_sidebars": bool(state.get("colored_sidebars", True)),
        "tile_margins": int(state.get("tile_margins", 8)),
    }


def render_gtk_css(state: dict) -> str:
    m = compute_glass_metrics(state)
    r = m["radius"]
    sidebar_icon_rule = (
        "/* macOS 27 Golden Gate: Full-color sidebar icons enabled */\n"
        ".navigation-sidebar image, .sidebar image, placessidebar image {\n"
        "    -gtk-icon-style: regular;\n"
        "    opacity: 1.0;\n"
        "}\n"
        if m["colored_sidebars"]
        else "/* Monochrome sidebar icons */\n"
             ".navigation-sidebar image { -gtk-icon-style: symbolic; }\n"
    )
    return f"""/* Auto-generated by GoldenGate OS Liquid Glass Engine (macOS 27 Golden Gate) */
/* Glass Level: {state['glass_level']}% | Mode: {state['appearance']} | Corner Radius: {r}px */

window, .background, .unified-window {{
    background-color: rgba({m['bg_rgb']}, {m['win_alpha']});
    color: {m['fg_hex']};
    border-radius: {r}px;
    border-top: 1px solid rgba(255, 255, 255, {m['specular_alpha']});
    box-shadow: 0 18px 42px rgba(0, 0, 0, {m['edge_shadow_alpha']}),
                0 0 0 1px rgba(0, 0, 0, 0.28);
}}

headerbar, .top-bar, toolbar {{
    background-color: rgba({m['toolbar_rgb']}, {m['win_alpha']});
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    min-height: 38px;
    padding: 2px 10px;
    border-top-left-radius: {r}px;
    border-top-right-radius: {r}px;
}}

/* macOS 27 Golden Gate Edge-to-Edge Full-Height Sidebar */
.navigation-sidebar, .sidebar, placessidebar, stacksidebar {{
    background-color: rgba({m['sidebar_rgb']}, {m['sidebar_alpha']});
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0px;
    margin: 0px;
    padding: 6px 4px;
}}

.navigation-sidebar row:selected, placessidebar row:selected {{
    background-color: rgba(10, 132, 255, 0.28);
    border-radius: 7px;
}}

{sidebar_icon_rule}
"""


def apply_state(state: dict, root: Path | None = None, reload_kwin: bool = True) -> dict:
    base = root if root else Path.home()
    save_state(state, base)
    m = compute_glass_metrics(state)
    css = render_gtk_css(state)

    for gtk_dir in ("gtk-3.0", "gtk-4.0"):
        target = base / ".config" / gtk_dir / "gtk.css"
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(css, encoding="utf-8")

    # Update Kvantum GoldenGate config for Qt6 apps
    kv_dir = base / ".config" / "Kvantum" / "GoldenGate"
    kv_dir.mkdir(parents=True, exist_ok=True)
    opacity_pct = int(round((1.0 - m["win_alpha"]) * 100))
    (kv_dir / "GoldenGate.kvconfig").write_text(
        f"""[%General]
author=GoldenGate OS
comment=macOS 27 Golden Gate Liquid Glass Theme
translucent_windows=true
blurring=true
popup_blurring=true
reduce_window_opacity={opacity_pct}
reduce_menu_opacity={min(40, opacity_pct + 5)}
respect_DE=true
scrollable_menu=true
submenu_overlap=0
tooltip_delay=300
tree_branch_line=false
composite=true

[Hacks]
transparent_dolphin_view=true
transparent_pcmanfm_sidepane=true
blur_translucent=true
transparent_menutitle=true
kcapacitybar_as_progressbar=true
""",
        encoding="utf-8",
    )
    (base / ".config" / "Kvantum" / "kvantum.kvconfig").write_text(
        "[General]\ntheme=GoldenGate\n",
        encoding="utf-8",
    )

    # Update KWin blur/corner/tiling config markers
    kwin_override = base / ".config" / "goldengate" / "kwin-liquid-glass.ini"
    kwin_override.write_text(
        f"""[Effect-blur]
BlurStrength={m['blur_strength']}
NoiseStrength=2

[Effect-better_blur_dx]
BlurStrength={m['blur_strength']}
RefractionStrength={m['refraction']}
WindowCornerRadius={m['radius']}
HasTopSpecularHighlight=true

[Tiling]
padding={m['tile_margins']}
""",
        encoding="utf-8",
    )

    if reload_kwin and root is None and shutil.which("qdbus6"):
        subprocess.run(
            ["qdbus6", "org.kde.KWin", "/KWin", "reconfigure"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )

    return m


def run_gui() -> int:
    try:
        from PyQt6.QtCore import Qt
        from PyQt6.QtGui import QFont
        from PyQt6.QtWidgets import (
            QApplication,
            QCheckBox,
            QComboBox,
            QHBoxLayout,
            QLabel,
            QPushButton,
            QSlider,
            QVBoxLayout,
            QWidget,
        )
    except ImportError:
        print("PyQt6 not available; use --set-level or --status.")
        return 0

    state = load_state()
    app = QApplication(sys.argv)
    win = QWidget()
    win.setWindowTitle("Liquid Glass & Appearance — Golden Gate")
    win.setFixedSize(500, 380)
    win.setStyleSheet("""
        QWidget {
            background-color: rgba(26, 28, 36, 235);
            color: #F4F6FA;
            font-family: 'Inter', sans-serif;
            border-radius: 10px;
        }
        QLabel { background: transparent; }
        QPushButton {
            background-color: #0A84FF;
            color: white;
            border-radius: 7px;
            padding: 7px 16px;
            font-weight: 600;
        }
        QComboBox {
            background-color: rgba(255, 255, 255, 24);
            border: 1px solid rgba(255, 255, 255, 45);
            border-radius: 7px;
            padding: 5px 10px;
        }
    """)

    layout = QVBoxLayout(win)
    layout.setContentsMargins(22, 20, 22, 20)
    layout.setSpacing(14)

    title = QLabel("macOS 27 Golden Gate — Liquid Glass")
    title.setFont(QFont("Inter", 15, QFont.Weight.Bold))
    layout.addWidget(title)

    subtitle = QLabel(
        "Adjust Liquid Glass translucency, background diffusion, edge-to-edge colored sidebars, and uniform corner radii."
    )
    subtitle.setWordWrap(True)
    subtitle.setStyleSheet("color: #A5B0C2; font-size: 12px;")
    layout.addWidget(subtitle)

    # Slider row
    slider_label = QLabel(f"Liquid Glass Translucency: {state['glass_level']}%")
    slider_label.setFont(QFont("Inter", 12, QFont.Weight.DemiBold))
    layout.addWidget(slider_label)

    slider = QSlider(Qt.Orientation.Horizontal)
    slider.setRange(0, 100)
    slider.setValue(state["glass_level"])
    layout.addWidget(slider)

    legend = QHBoxLayout()
    legend.addWidget(QLabel("Opaque Tinted (High Contrast)"))
    legend.addStretch()
    legend.addWidget(QLabel("Max Liquid Glass"))
    layout.addLayout(legend)

    # Appearance selector
    mode_row = QHBoxLayout()
    mode_row.addWidget(QLabel("Appearance:"))
    mode_box = QComboBox()
    mode_box.addItems(["dark", "light", "auto"])
    mode_box.setCurrentText(state.get("appearance", "dark"))
    mode_row.addWidget(mode_box)
    layout.addLayout(mode_row)

    # Colored sidebars checkbox
    sidebar_cb = QCheckBox("Edge-to-Edge Full-Height Sidebars with Colored Icons")
    sidebar_cb.setChecked(bool(state.get("colored_sidebars", True)))
    layout.addWidget(sidebar_cb)

    # Window snap margins checkbox
    margin_cb = QCheckBox("Window Snap Margins (8px Golden Gate gap around tiled windows)")
    margin_cb.setChecked(int(state.get("tile_margins", 8)) > 0)
    layout.addWidget(margin_cb)

    def sync_all() -> None:
        state["glass_level"] = slider.value()
        state["appearance"] = mode_box.currentText()
        state["colored_sidebars"] = sidebar_cb.isChecked()
        state["tile_margins"] = 8 if margin_cb.isChecked() else 0
        slider_label.setText(f"Liquid Glass Translucency: {state['glass_level']}%")
        apply_state(state)

    slider.valueChanged.connect(lambda _: sync_all())
    mode_box.currentTextChanged.connect(lambda _: sync_all())
    sidebar_cb.toggled.connect(lambda _: sync_all())
    margin_cb.toggled.connect(lambda _: sync_all())

    layout.addStretch()
    close_btn = QPushButton("Done")
    close_btn.clicked.connect(win.close)
    layout.addWidget(close_btn, alignment=Qt.AlignmentFlag.AlignRight)

    win.show()
    return app.exec()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="GoldenGate OS Liquid Glass Engine")
    parser.add_argument("--set-level", type=int, help="Set Liquid Glass level (0..100)")
    parser.add_argument("--mode", choices=["dark", "light", "auto"], help="Set appearance mode")
    parser.add_argument("--radius", type=int, help="Set uniform window corner radius in px (default 10)")
    parser.add_argument("--tile-margins", type=int, help="Set window snap margins in px (default 8)")
    parser.add_argument("--apply-default", action="store_true", help="Initialize default Golden Gate glass config")
    parser.add_argument("--root", type=str, help="Optional target home/skel directory")
    parser.add_argument("--status", action="store_true", help="Print current Liquid Glass JSON status")
    args = parser.parse_args(argv)

    root_path = Path(args.root) if args.root else None
    state = load_state(root_path)

    changed = args.apply_default
    if args.set_level is not None:
        state["glass_level"] = max(0, min(100, args.set_level))
        changed = True
    if args.mode is not None:
        state["appearance"] = args.mode
        changed = True
    if args.radius is not None:
        state["corner_radius"] = max(4, min(18, args.radius))
        changed = True
    if args.tile_margins is not None:
        state["tile_margins"] = max(0, min(20, args.tile_margins))
        changed = True

    if changed:
        metrics = apply_state(state, root=root_path, reload_kwin=(root_path is None))
        if args.status:
            print(json.dumps({"state": state, "metrics": metrics}, indent=2))
        return 0

    if args.status:
        print(json.dumps({"state": state, "metrics": compute_glass_metrics(state)}, indent=2))
        return 0

    return run_gui()


if __name__ == "__main__":
    raise SystemExit(main())
